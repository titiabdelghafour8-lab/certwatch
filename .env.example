# Environment for running certwatch-server directly (outside Docker).
# Full reference: docs/configuration.md
CERTWATCH_DATABASE_URL=postgres://certwatch:certwatch@localhost:5432/certwatch?sslmode=disable
CERTWATCH_LISTEN_ADDR=:8080
CERTWATCH_PUBLIC_URL=http://localhost:8080
CERTWATCH_LOG_FORMAT=text
CERTWATCH_LOG_LEVEL=debug
