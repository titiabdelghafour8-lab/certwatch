# ---- Required ----
# Public hostname pointing at this server (A/AAAA record). Caddy obtains the TLS certificate.
CERTWATCH_DOMAIN=api.example.com
CERTWATCH_PUBLIC_URL=https://api.example.com
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Image tag to run (a release such as v1.0.0, or "latest").
CERTWATCH_VERSION=latest

# ---- Email (strongly recommended: signup keys and alerts are emailed) ----
# Any SMTP provider works: Postmark, Resend, Amazon SES, Mailgun, Brevo...
CERTWATCH_SMTP_HOST=smtp.postmarkapp.com
CERTWATCH_SMTP_PORT=587
CERTWATCH_SMTP_USERNAME=
CERTWATCH_SMTP_PASSWORD=
CERTWATCH_SMTP_FROM=certwatch <alerts@example.com>

# ---- Billing (optional; leave empty to disable) ----
CERTWATCH_STRIPE_SECRET_KEY=
CERTWATCH_STRIPE_WEBHOOK_SECRET=
CERTWATCH_STRIPE_PRICE_PRO=
CERTWATCH_STRIPE_PRICE_AGENCY=

# ---- Policy ----
CERTWATCH_SIGNUP_ENABLED=true
# Use "unlimited" for a private, self-hosted instance without billing.
CERTWATCH_DEFAULT_PLAN=free

# ---- Operations ----
CERTWATCH_LOG_LEVEL=info
# Protects /metrics when scraped directly from the containers.
CERTWATCH_METRICS_TOKEN=
